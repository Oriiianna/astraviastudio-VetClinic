# En desarrollo se deja vacio o con /api: el proxy de Vite redirige a PHP y
# front y API comparten origen (ver vite.config.js). Asi la cookie httpOnly
# del refresh token viaja sin conflictos de SameSite.
VITE_API_URL=/api

# En produccion, si la API vive en otro dominio, poner la URL absoluta y
# agregar ese origen a CORS_ALLOWED_ORIGINS en backend/.env
# VITE_API_URL=https://api.miclinica.com/api
