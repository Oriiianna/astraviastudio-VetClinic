# Copiar a .env y completar. NUNCA versionar el .env real.

APP_ENV=development          # development | production
APP_NAME="Veterinaria API"

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=veterinaria
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- JWT ---
# Generar con: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_ALEATORIA_DE_64_CARACTERES
JWT_ISSUER=veterinaria-api
JWT_ACCESS_TTL=900           # 15 minutos, en segundos
JWT_REFRESH_TTL=604800       # 7 dias, en segundos

# --- CORS ---
# Lista separada por comas. Sin comodines: se usa junto con credenciales.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Cookies ---
# En produccion (HTTPS) poner COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Seguridad de login ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
