{
  "name": "veterinaria/api",
  "description": "API RESTful para la gestion integral de una clinica veterinaria",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.1",
    "ext-pdo": "*",
    "ext-json": "*",
    "slim/slim": "^4.12",
    "slim/psr7": "^1.6",
    "php-di/php-di": "^7.0",
    "firebase/php-jwt": "^6.10",
    "vlucas/phpdotenv": "^5.6",
    "monolog/monolog": "^3.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "start": "php -S 127.0.0.1:8080 -t public",
    "hash": "php bin/hash.php"
  },
  "config": {
    "sort-packages": true
  }
}
